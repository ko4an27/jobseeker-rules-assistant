# Copy to .env and fill in. .env is git-ignored.
# Which LLM to use: "anthropic" (default) or "fake" (no key, offline demo).
LLM_PROVIDER=anthropic
# Cheap model for development; change for evals if needed.
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Langfuse tracing: off unless LANGFUSE_ENABLED=true. Keys only here, never in code.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Also send question and answer text (questions may contain personal data). Default: metadata only.
LANGFUSE_LOG_TEXT=false
