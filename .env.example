# Copy to .env and fill in. .env is git-ignored and read automatically by
# make ask / api / eval-real / judge-calibrate (variables already set in your shell win).

# Which model answers: gemini or groq (free tiers), anthropic, or fake (no key, offline demo).
LLM_PROVIDER=gemini
# The provider's key (ANTHROPIC_API_KEY also works for anthropic).
LLM_API_KEY=
# Leave empty for the provider's default (gemini-3.7-flash / llama-3.3-70b-versatile /
# claude-haiku-5-5). Cheaper Gemini option: gemini-3.5-flash-lite. Set it if a model is retired.
LLM_MODEL=
# Gemini 3.x only: how much the model "thinks" first (billed as output tokens).
# Empty = smallest allowed (Flash-Lite: minimal, Flash: low).
LLM_THINKING_LEVEL=

# Optional: a different model as the eval judge (a model judging itself is lenient).
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# Eval guard: at most this many real model calls per run.
EVAL_MAX_CALLS=200
# Paid providers only (free tiers count as 0): price per million tokens, for the cost report.
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Langfuse tracing: off unless LANGFUSE_ENABLED=true. Keys only here, never in code.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Also send question and answer text (questions may contain personal data). Default: metadata only.
LANGFUSE_LOG_TEXT=false

# API protection. Rate limit per client per minute (0 = off). API_KEY empty = no key needed.
RATE_LIMIT_PER_MINUTE=10
API_KEY=
